#!/bin/sh
# wani-show FILE : sends an image to the Wani Terminal graphics strip.
# Supported: png, jpg, gif, webp. Tap an image for preview and "Save to Downloads".
if [ -z "$1" ]; then
  echo "Usage: wani-show FILE.png"
  exit 1
fi
if [ ! -f "$1" ]; then
  echo "File not found: $1"
  exit 1
fi
NAME=$(basename "$1" | base64 -w0)
printf '\033]1337;File=inline=1;name=%s:' "$NAME"
base64 -w0 "$1"
printf '\a'
echo "Sent to graphics strip: $(basename "$1")"
